 "descriptions": {
  "en": {
   "spellbound:acceleration": "Mining speed increases during use.",
   "spellbound:airline": "Drags the user behind fired projectile.",
   "spellbound:attractive": "Attracts nearby entities.",
   "spellbound:buffered": "Protects durability with regenerating buffer.",
   "spellbound:cave_in": "Shot blocks fall to the ground",
   "spellbound:chilled": "Freeze adjacent blocks on break",
   "spellbound:death_wish": "Provides no protection. Greatly increases damage.",
   "spellbound:demolition": "Creates explosions when mining. Hard on your tool.",
   "spellbound:despoiling": "Triggers kill streaks, and has better looting during kill streaks",
   "spellbound:dullness": "Reduces damage done by tool.",
   "spellbound:fisher_of_men": "Deals damage to pulled entities and grants fish if lethal.",
   "spellbound:flesh_wound": "Grants absorption hearts when injured.",
   "spellbound:goldskin": "Grants absorption hearts that regenerate out of combat.",
   "spellbound:grace": "Greatly extends and improves I-Frames.",
   "spellbound:hearty": "Greatly increases max health.",
   "spellbound:hover": "Hold elevation briefly upon midair jump.",
   "spellbound:impersonal": "Teleports user behind targets.",
   "spellbound:jousting": "Increase damage with relative velocity.",
   "spellbound:last_gasp": "Enter dying state on lethal damage, recover on kill.",
   "spellbound:launching": "Knock targets skyward.",
   "spellbound:legacy": "Creates enchanted book when item breaks.",
   "spellbound:metabolising": "Consumes hunger to restore durability.",
   "spellbound:outburst": "Burst free when hit multiple times.",
   "spellbound:pestilence": "Spread status effects to nearby foes and damage them.",
   "spellbound:phase_leap": "Phase forward upon midair jump.",
   "spellbound:phase_strafe": "Phase with your motion upon midair jump.",
   "spellbound:photosynthetic": "Restores itself in the light.",
   "spellbound:pinata": "Large but infrequent loot explosions.",
   "spellbound:priming": "Sets target to explode. Multiple hits increase yield.",
   "spellbound:prospector": "Find trace minerals in earth, more if near ore.",
   "spellbound:rampage": "Massive damage after kills.",
   "spellbound:red_alert": "Barriers negate next damage source.",
   "spellbound:repulsive": "Repulses nearby entities",
   "spellbound:resurfacing": "Returns as treasure when lost or broken.",
   "spellbound:rock_collecting": "Mining speed grows with unique rocks mined.",
   "spellbound:saturated": "Consumes saturation instead of durability.",
   "spellbound:scalping": "Attacks tear free bonus drops, scaling with damage.",
   "spellbound:selfish": "Takes durability from other equipment.",
   "spellbound:skotosynthetic": "Restores itself in the night.",
   "spellbound:spikes": "Damages very close entities.",
   "spellbound:storied": "Upgrades and adds enchantments as the item's story develops.",
   "spellbound:sunken_treasure": "Finds crates while fishing.",
   "spellbound:tethering": "Pulls target to weapon.",
   "spellbound:trophy_collecting": "Damage grows with unique foes slain.",
   "spellbound:universal": "Tool is suitable for all blocks, with speed penalty for off-type blocks.",
   "spellbound:vengeful": "Built up damage becomes followup strikes when user strikes back.",
   "spellbound:warlike": "Declares war upon the world, increasing difficulty.",
   "spellbound:widened": "Tool breaks matching blocks in small plane around target."
  }
